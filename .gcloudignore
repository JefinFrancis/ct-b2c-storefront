# .gcloudignore — Exclude files from GCP deployments
# Similar to .gitignore but for gcloud deployments

# Git
.git
.gitignore
.github/

# Dependencies & Build artifacts (handled in Dockerfile)
node_modules/
**/node_modules/
.turbo/
dist/
.next/
coverage/

# Development files
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
vitest.config.ts
jest.config.js

# Environment files (use Secret Manager instead)
.env
.env.*
!.env.example

# IDE and OS files
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# Documentation (not needed in production)
docs/
*.md
!README.md

# CI/CD
.github/
.gitlab-ci.yml

# Docker
Dockerfile
.dockerignore
docker-compose.yml

# Scripts
scripts/

# BMAD framework (not needed in production)
_bmad/
_bmad-output/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
